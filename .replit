modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["cacert", "ffmpeg-full", "freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Working Bot"

[[workflows.workflow]]
name = "Working Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python bot.py"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[deployment]
deploymentTarget = "vm"
run = ["python", "bot.py"]

[userenv]

[userenv.shared]

[[ports]]
localPort = 10000
externalPort = 80
