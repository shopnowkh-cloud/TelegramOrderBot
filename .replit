modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["cacert", "ffmpeg-full", "freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[workflows]

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[deployment]
deploymentTarget = "vm"
run = ["python", "bot.py"]

[userenv]

[userenv.shared]
TELEGRAM_ADMIN_ID = "5002402843"

[[ports]]
localPort = 10000
externalPort = 80
